# Environment Variables for GCP PCA Quiz App
PORT=8080
NODE_ENV=production
# Target Firestore Native database created by user
FIRESTORE_DATABASE_ID=certificacao
GCP_REGION=southamerica-east1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Path to service account key file for local testing with Firestore
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
